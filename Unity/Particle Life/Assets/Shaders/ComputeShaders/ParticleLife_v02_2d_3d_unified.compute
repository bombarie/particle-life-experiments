/* Each #kernel tells which function to compile; you can have many kernels */
#pragma kernel CSMain
#pragma kernel CalcPositions2D
#pragma kernel CalcPositions3D

// RWTexture2D<float4> BuildingMask;

float maxRange = 90.0f;
float minRange = 3.0f;

float maxDotSpeed = 3.0f;

float proximityRepulseForce = 3.0f;
float attractionForce = 3.0f;
float attractionForceDivFactor = 10.0;
float globalFriction = .9;

float worldBoundsMinX;
float worldBoundsMinY;
float worldBoundsMinZ;

float worldBoundsMaxX;
float worldBoundsMaxY;
float worldBoundsMaxZ;

float deltaTime;

struct Dot {
    int dotType;
    float3 position;
    float3 speed;
};
int numDots;

struct InteractSettings {
	float minDistance;
	float minDistanceRepelPow;
	float minDistanceRepelStrength;
	float interactDistance;
	float interactStrength; // range [-1,1]
};

struct DotType {
	int colorIndex;
	float friction;
	float size;
	InteractSettings interactSettings;
};
int numDotTypes;

int dotRepelMethod = 1;

RWStructuredBuffer<Dot> DotsBuffer;
StructuredBuffer<DotType> DotTypesBuffer;

float boundsDeflectMinDistance;
float boundsDeflectPowFactor;
float boundsDeflectStrength;


RWStructuredBuffer<float3> DotsPositionBuffer;

// not RW because we don't need to write to it
StructuredBuffer<float> colorMatrixBuffer;

int numColors;

static const int threadGroupSize = 1024;

// helpful: https://www.youtube.com/watch?v=V-yqiLyU27U

//*   
float GetColorInteractionByIndex(int p1, int p2) {
  float f = 0.0;

  f = colorMatrixBuffer[p1 + numColors * p2];

  return f;
}
//*/

[numthreads(threadGroupSize, 1, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    Dot d = DotsBuffer[id.x];
	DotType dt = DotTypesBuffer[d.dotType];

    for (int j = 0; j < numDots; j++) {
        Dot d2 = DotsBuffer[j];
        if ((uint)id.x != (uint)j) {

			float _dist = distance(d.position, d2.position);
            // apply forces

            // ensure minimum distance between the dots   
            // if (distance(d.position, d2.position) < (d.size + minRange)) { 
            if (_dist < dt.interactSettings.minDistance) {
				float pctDist = 1.0 - (_dist / dt.interactSettings.minDistance);
				float repelPow = pow(pctDist, dt.interactSettings.minDistanceRepelPow) * dt.interactSettings.minDistanceRepelStrength;
                float3 _f1 = d2.position - d.position;
                _f1 = normalize(_f1);

				if (dotRepelMethod == 1) {
	                d.speed += _f1 * (-proximityRepulseForce * attractionForce / attractionForceDivFactor);
				}
				if (dotRepelMethod == 2) {
					d.speed += _f1 * -repelPow * proximityRepulseForce;
    			}
                // d.speed += _f1 * -repelPow;
            }
			
            // if within configured radius: attract or repel (dependent on color-matrix)  
            else if (_dist < dt.interactSettings.interactDistance) {
                float colorInteraction = GetColorInteractionByIndex(d.dotType, d2.dotType);

				float pctDist = _dist / dt.interactSettings.interactDistance;
				float calcedCurve = (0.5 - abs(pctDist - 0.5)) * 2.0 * dt.interactSettings.interactStrength;

                float3 _f1 = d2.position - d.position;
                _f1 = normalize(_f1);

                // d.speed += _f1 * (colorInteraction * attractionForce / attractionForceDivFactor);
                d.speed += _f1 * calcedCurve * (colorInteraction * attractionForce / attractionForceDivFactor);
				// d.speed += deltaTime;
                // d.speed += _f1 * (1.0 * attractionForce / attractionForceDivFactor); // TODO: replace '1.0' with colorInteraction! 

            }
        }
    }

	//* handle bounds
	float _pctDist;
	if (abs(d.position.x - worldBoundsMinX) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.x - worldBoundsMinX) / boundsDeflectMinDistance);
		d.speed += float3(1.0, 0.0, 0.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	if (abs(d.position.x - worldBoundsMaxX) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.x - worldBoundsMaxX) / boundsDeflectMinDistance);
		d.speed += float3(-1.0, 0.0, 0.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	if (abs(d.position.y - worldBoundsMinY) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.y - worldBoundsMinY) / boundsDeflectMinDistance);
		d.speed += float3(0.0, 1.0, 0.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	if (abs(d.position.y - worldBoundsMaxY) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.y - worldBoundsMaxY) / boundsDeflectMinDistance);
		d.speed += float3(0.0, -1.0, 0.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	if (abs(d.position.z - worldBoundsMinZ) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.z - worldBoundsMinZ) / boundsDeflectMinDistance);
		d.speed += float3(0.0, 0.0, 1.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	if (abs(d.position.z - worldBoundsMaxZ) < boundsDeflectMinDistance) {
		_pctDist = 1.0 - (abs(d.position.z - worldBoundsMaxZ) / boundsDeflectMinDistance);
		d.speed += float3(0.0, 0.0, -1.0) * boundsDeflectStrength * pow(_pctDist, boundsDeflectPowFactor);
	}
	//*/

    if (length(d.speed) > maxDotSpeed) {
        d.speed = normalize(d.speed) * maxDotSpeed;
    }

    DotsBuffer[id.x] = d;	
}

float3 constrainToBounds(float3 d) {
	d.x = clamp(d.x, worldBoundsMinX, worldBoundsMaxX);
	d.y = clamp(d.y, worldBoundsMinY, worldBoundsMaxY);
	d.z = clamp(d.z, worldBoundsMinZ, worldBoundsMaxZ);

	return d;
}

// TODO -> unify CalcPositions2D and CalcPositions3D -> it's ridiculously the same
[numthreads(threadGroupSize, 1, 1)]
void CalcPositions2D (uint3 id : SV_DispatchThreadID)
{
    Dot d = DotsBuffer[id.x];
	DotType dt = DotTypesBuffer[d.dotType];

	// update positions
	d.position += d.speed * 60.0 * deltaTime;
	// DotsBuffer[id.x].speed *= DotsBuffer[id.x].friction; 

	// d.speed *= globalFriction;
	d.speed *= dt.friction;


	// constrain to world
	if (d.position.x < worldBoundsMinX) {
		d.speed.x *= -1.0;
		d.position.x = worldBoundsMinX;
	}
	if (d.position.y < worldBoundsMinY) {
		d.speed.y *= -1.0;
		d.position.y = worldBoundsMinY;
	}

	if (d.position.x > worldBoundsMaxX) {
		d.speed.x *= -1.0;
		d.position.x = worldBoundsMaxX;
	}
	if (d.position.y > worldBoundsMaxY) {
		d.speed.y *= -1.0;
		d.position.y = worldBoundsMaxY;
	}

	d.position.z = 0.0; // necessary to constrain? 

	d.position = constrainToBounds(d.position);

    DotsBuffer[id.x] = d;
	DotsPositionBuffer[id.x] = d.position;
}



[numthreads(threadGroupSize, 1, 1)]
void CalcPositions3D (uint3 id : SV_DispatchThreadID)
{
    Dot d = DotsBuffer[id.x];
	DotType dt = DotTypesBuffer[d.dotType];

	// update positions
	d.position += d.speed * 60.0 * deltaTime;
	// DotsBuffer[id.x].speed *= DotsBuffer[id.x].friction;

	// d.speed *= globalFriction;
	d.speed *= dt.friction;


	// constrain to world
	if (d.position.x < worldBoundsMinX) {
		d.speed.x *= -1.0;
		d.position.x = worldBoundsMinX;
	}
	if (d.position.y < worldBoundsMinY) {
		d.speed.y *= -1.0;
		d.position.y = worldBoundsMinY;
	}
	if (d.position.z < worldBoundsMinZ) {
		d.speed.z *= -1.0;
		d.position.z = worldBoundsMinZ;
	}

	if (d.position.x > worldBoundsMaxX) {
		d.speed.x *= -1.0;
		d.position.x = worldBoundsMaxX;
	}
	if (d.position.y > worldBoundsMaxY) {
		d.speed.y *= -1.0;
		d.position.y = worldBoundsMaxY;
	}
	if (d.position.z > worldBoundsMaxZ) {
		d.speed.z *= -1.0;
		d.position.z = worldBoundsMaxX;
	}

	d.position = constrainToBounds(d.position);

    DotsBuffer[id.x] = d;
    DotsPositionBuffer[id.x] = d.position;
}


